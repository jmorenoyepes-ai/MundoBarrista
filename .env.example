# ============================================
# MundoBarrista — Variables de Entorno
# ============================================
# Copia este archivo como .env y ajusta los valores.

# --- Base de datos (PostgreSQL) ---
DATABASE_URL="postgresql://mundobarrista:mundobarrista_dev@localhost:5432/mundobarrista?schema=public"
POSTGRES_USER=mundobarrista
POSTGRES_PASSWORD=mundobarrista_dev
POSTGRES_DB=mundobarrista

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Modo de datos ---
# true  = Datos locales mock (desarrollo sin API externa)
# false = Consulta API-Football con caché en Redis
USE_MOCK_DATA=true

# --- API-Football (solo cuando USE_MOCK_DATA=false) ---
API_FOOTBALL_KEY=your_api_football_key_here
API_FOOTBALL_HOST=v3.football.api-sports.io
API_FOOTBALL_LEAGUE_ID=239

# --- Next.js ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
